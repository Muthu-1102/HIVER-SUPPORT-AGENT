# LLM-as-a-Judge Evaluation Configuration (OpenRouter or Groq)
# Copy this file to .env and insert your real API key.
# DO NOT commit .env or paste real keys into this template.

# Active Provider: "openrouter" or "groq" (Optional, auto-detected from active API key)
LLM_JUDGE_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Groq Configuration (Alternative Provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
